# dependencies
node_modules/

# build outputs
dist/
out/
.next/
*.tgz

# dashboard build bundled into relay
packages/relay/public/

# local work logs (not for contributors) — the conventions file is committed,
# because AGENTS.md and INDEX.md link to it and the logs themselves stay private
.work/*
!.work/CLAUDE.md

# env
.env
.env.local
.env.*.local

# tapflow runtime config (auto-generated, may contain local paths)
tapflow.config.json

# os
.DS_Store

# playwright mcp artifacts
.playwright-mcp/
*.png
!docs/public/*.png

# vscode
.vscode

# typescript build cache
*.tsbuildinfo

# cli pack artifacts
*.tgz

# claude code personal settings (team settings and commands are tracked)
.claude/settings.local.json

# sqlite wal/shm temp files
*.db-shm
*.db-wal

# runtime data (recordings, uploads, db, generated jwt-secret) — any package/cwd.
# **/ prefix so it matches in subpackages too (a mid-pattern slash would anchor to repo root).
# .tapflow/flows/ stays tracked — only the runtime subdirs are ignored.
**/.tapflow/data/
**/.tapflow/artifacts/
.tapflow-data/

# playground test builds
playground/test-builds/

# playground demo/local scripts (not for contributors)
playground/demo-seed.ts
playground/multi-agent.ts

# VitePress
docs/.vitepress/cache
docs/.vitepress/dist
.internal/

# curl test artifacts
cookies.txt

# skills install artifacts (a11y-lens etc.)
.agents/
skills-lock.json

# ios-netfilter: sysext build output (like xctest-runner/build)
packages/ios-agent/ios-netfilter/build/

# netprobe: both are generated by its build.sh on every run. Unlike xctest-runner's project, nothing
# but that script consumes them, and xcodegen rewrites every identifier each time — committing it
# would churn for no reader.
packages/ios-agent/netprobe/TapflowNetProbe.xcodeproj/
packages/ios-agent/netprobe/build/
# ios-netfilter: the Swift test project is generated from tests.yml on every run (run-tests.sh).
# Unlike TapflowNetFilter.xcodeproj it is NOT committed — nothing but the test script consumes it, and
# xcodegen rewrites every identifier each time, so committing it would churn for no reader.
packages/ios-agent/ios-netfilter/TapflowNetFilterTests.xcodeproj/
